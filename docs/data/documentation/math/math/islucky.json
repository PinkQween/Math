s"},{"type":"text","text":" "},{"type":"text","text":"from the natural numbers sequence using the following"},{"type":"text","text":" "},{"type":"text","text":"sieve process:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Start with the positive integers: 1, 2, 3, 4, 5, …"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Remove every 2nd number, leaving 1, 3, 5, 7, 9, …"}]}]},{"content":[{"inlineContent":[{"text":"The next surviving number is 3, so remove every 3rd","type":"text"},{"text":" ","type":"text"},{"text":"number, leaving 1, 3, 7, 9, 13, 15, …","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The next surviving number is 7, so remove every 7th"},{"type":"text","text":" "},{"type":"text","text":"number."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Continue this process indefinitely."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"The resulting sequence is:"},{"type":"text","text":" "},{"code":"1, 3, 7, 9, 13, 15, 21, 25, 31, 33, ...","type":"codeVoice"}],"type":"paragraph"},{"anchor":"Example","type":"heading","level":3,"text":"Example"},{"code":["Math(7).isLucky      \/\/ true","Math(8).isLucky      \/\/ false","Math(13).isLucky     \/\/ true"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Lucky numbers share some similarities with primes, but","type":"text"},{"text":" ","type":"text"},{"text":"arise from a distinct sieving process.","type":"text"}]}],"kind":"content"}],"references":{"doc://math.Math/documentation/Math/Math/isLucky":{"title":"isLucky","type":"topic","url":"\/documentation\/math\/math\/islucky","identifier":"doc:\/\/math.Math\/documentation\/Math\/Math\/isLucky","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"isLucky"},{"kind":"text","text":": "},{"kind":"typeIdentifier"