t surviving number is 3, so remove every 3rd"},{"type":"text","text":" "},{"type":"text","text":"number, leaving 1, 3, 7, 9, 13, 15, …"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The next surviving number is 7, so remove every 7th"},{"type":"text","text":" "},{"text":"number.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Continue this process indefinitely."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting sequence is:"},{"type":"text","text":" "},{"code":"1, 3, 7, 9, 13, 15, 21, 25, 31, 33, ...","type":"codeVoice"}]},{"type":"heading","text":"Example","level":3,"anchor":"Example"},{"type":"codeListing","code":["Math(7).isLucky      \/\/ true","Math(8).isLucky      \/\/ false","Math(13).isLucky     \/\/ true"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Lucky numbers share some similarities with primes, but"},{"type":"text","text":" "},{"type":"text","text":"arise from a distinct sieving process."}]}],"kind":"content"}],"kind":"symbol","sections":[],"metadata":{"roleHeading":"Instance Property","externalID":"s:4MathAAV7isLuckySbvp","extendedModule":"Math","modules":[{"name":"Math"}],"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isLucky","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"symbolKind":"property","title":"isLucky"},"hierarchy":{"paths":[["doc:\/\/math.Math\/documentation\/Math","doc:\/\/math.Math\/documentation\/Math\/Math"]]},"references":{"doc://math.Math/documentation/Math":{"role":"collection","url":"\/documentation\/math","type":"topic","kind":"symbol","title":"Math","identifier":"doc:\/\/math.Math\/documentation\/Math","abstract":[{"type":"text","text":"A comprehensive, high-precision mathematical computation library for Swift."}]},"doc://math.Math/documentation/Math/Math":{"title":"Math",