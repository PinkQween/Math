{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/math.Math\/documentation\/Math","doc:\/\/math.Math\/documentation\/Math\/Math"]]},"kind":"symbol","identifier":{"url":"doc:\/\/math.Math\/documentation\/Math\/Math\/isLucky","interfaceLanguage":"swift"},"metadata":{"role":"symbol","roleHeading":"Instance Property","symbolKind":"property","title":"isLucky","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isLucky","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"extendedModule":"Math","externalID":"s:4MathAAV7isLuckySbvp","modules":[{"name":"Math"}]},"abstract":[{"type":"text","text":"A Boolean value indicating whether this number is a"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"lucky number","type":"text"}]},{"type":"text","text":" according to the Josephus Flavius sieve."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isLucky","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if this number is lucky, otherwise ","type":"text"},{"type":"codeVoice","code":"false"},{"text":".","type":"text"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Lucky numbers are defined by repeatedly removing numbers","type":"text"},{"text":" ","type":"text"},{"text":"from the natural numbers sequence using the following","type":"text"},{"text":" ","type":"text"},{"text":"sieve process:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Start with the positive integers: 1, 2, 3, 4, 5, …","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Remove every 2nd number, leaving 1, 3, 5, 7, 9, …","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The next surviving number is 3, so remove every 3rd","type":"text"},{"text":" ","type":"text"},{"text":"number, leaving 1, 3, 7, 9, 13, 15, …","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The next surviving number is 7, so remove every 7th","type":"text"},{"text":" ","type":"text"},{"text":"number.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Continue this process indefinitely.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The resulting sequence is:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"1, 3, 7, 9, 13, 15, 21, 25, 31, 33, ..."}]},{"type":"heading","text":"Example","anchor":"Example","level":3},{"type":"codeListing","syntax":"swift","code":["Math(7).isLucky      \/\/ true","Math(8).isLucky      \/\/ false","Math(13).isLucky     \/\/ true"]},{"type":"paragraph","inlineContent":[{"text":"Lucky numbers share some similarities with primes, but","type":"text"},{"text":" ","type":"text"},{"text":"arise from a distinct sieving process.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/math\/islucky"]}],"sections":[],"references":{"doc://math.Math/documentation/Math":{"role":"collection","title":"Math","url":"\/documentation\/math","abstract":[{"text":"A comprehensive, high-precision mathematical computation library for Swift.","type":"text"}],"identifier":"doc:\/\/math.Math\/documentation\/Math","kind":"symbol","type":"topic"},"doc://math.Math/documentation/Math/Math":{"role":"symbol"