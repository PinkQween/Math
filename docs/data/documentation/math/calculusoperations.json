{"topicSections":[{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/Math\/derivative(of:at:h:)","doc:\/\/math.Math\/documentation\/Math\/Math\/secondDerivative(of:at:h:)","doc:\/\/math.Math\/documentation\/Math\/Math\/nthDerivative(of:n:at:h:)"],"anchor":"Derivatives","title":"Derivatives"},{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/Math\/integrate(_:from:to:intervals:)","doc:\/\/math.Math\/documentation\/Math\/Math\/simpsonIntegrate(_:from:to:intervals:)","doc:\/\/math.Math\/documentation\/Math\/Math\/improperIntegrate(_:from:upperBound:intervals:)"],"anchor":"Integration","title":"Integration"},{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/Math\/arithmeticSeries(firstTerm:difference:terms:)","doc:\/\/math.Math\/documentation\/Math\/Math\/geometricSeries(firstTerm:ratio:terms:)","doc:\/\/math.Math\/documentation\/Math\/Math\/infiniteGeometricSeries(firstTerm:ratio:)","doc:\/\/math.Math\/documentation\/Math\/Math\/sum(from:to:term:)","doc:\/\/math.Math\/documentation\/Math\/Math\/product(from:to:term:)"],"anchor":"Series","title":"Series"},{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/Math\/limit(of:approaching:epsilon:)","doc:\/\/math.Math\/documentation\/Math\/Math\/limitAtInfinity(of:largeValue:)"],"anchor":"Limits","title":"Limits"},{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/Math\/bisectionRoot(of:in:tolerance:maxIterations:)","doc:\/\/math.Math\/documentation\/Math\/Math\/newtonRoot(of:initialGuess:tolerance:maxIterations:)"],"anchor":"Root-Finding","title":"Root Finding"},{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/Math\/taylorSeries(of:around:at:terms:)"],"anchor":"Taylor-Series","title":"Taylor Series"}],"seeAlsoSections":[{"identifiers":["doc:\/\/math.Math\/documentation\/Math\/ComplexNumbers","doc:\/\/math.Math\/documentation\/Math\/StatisticalAnalysis"],"generated":true,"title":"New Features","anchor":"New-Features"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The Math library provides comprehensive numerical calculus operations for arbitrary-precision computations. These operations are particularly useful for scientific computing, optimization, and mathematical analysis.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Derivatives","anchor":"Derivatives","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate numerical derivatives using the central difference method."}]},{"text":"First Derivative","anchor":"First-Derivative","level":4,"type":"heading"},{"syntax":"swift","code":["\/\/ Derivative of f(x) = x²","let derivative = Math.derivative(of: { x in x * x }, at: 3)","print(derivative)  \/\/ ≈6 (exact: 2x = 2×3 = 6)","","\/\/ Derivative of f(x) = sin(x)","let sinDerivative = Math.derivative(of: { x in Math.sin(x) }, at: 0)","print(sinDerivative)  \/\/ ≈1 (exact: cos(0) = 1)","","\/\/ Custom step size for higher precision","let preciseDerivative = Math.derivative(","    of: { x in x * x * x },","    at: 2,","    h: 0.00001",")"],"type":"codeListing"},{"anchor":"Higher-Order-Derivatives","level":4,"text":"Higher-Order Derivatives","type":"heading"},{"type":"codeListing","code":["\/\/ Second derivative of f(x) = x²","let secondDerivative = Math.secondDerivative(of: { x in x * x }, at: 5)","print(secondDerivative)  \/\/ ≈2 (constant for quadratic)","","\/\/ Nth derivative","let fourthDerivative = Math.nthDerivative(","    of: { x in x ** 5 },","    n: 4,","    at: 1",")","print(fourthDerivative)  \/\/ ≈120 (5! \/ 1! = 120)"],"syntax":"swift"},{"type":"heading","anchor":"Integration","text":"Integration","level":3},{"type":"paragraph","inlineContent":[{"text":"Compute definite integrals using numerical methods.","type":"text"}]},{"type":"heading","anchor":"Trapezoidal-Rule","text":"Trapezoidal Rule","level":4},{"inlineContent":[{"type":"text","text":"Basic integration using trapezoids:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ ∫₀¹ x dx = 0.5","let integral = Math.integrate({ x in x }, from: 0, to: 1)","print(integral)  \/\/ ≈0.5","","\/\/ ∫₀^π sin(x) dx = 2","let sinIntegral = Math.integrate(","    { x in Math.sin(x) },","    from: 0,","    to: .pi,","    intervals: 1000",")","print(sinIntegral)  \/\/ ≈2","","\/\/ More intervals = higher accuracy","let precise = Math.integrate(","    { x in x * x },","    from: 0,","    to: 1,","    intervals: 10000",")"],"syntax":"swift"},{"text":"Simpson’s Rule","type":"heading","anchor":"Simpsons-Rule","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"More accurate integration using quadratic approximation:"}]},{"type":"codeListing","code":["\/\/ ∫₀¹ x² dx = 1\/3","let integral = Math.simpsonIntegrate(","    { x in x * x },","    from: 0,","    to: 1,","    intervals: 100",")","print(integral)  \/\/ ≈0.333...","","\/\/ Simpson's rule is more accurate for smooth functions","let accurate = Math.simpsonIntegrate(","    { x in Math.exp(x) },","    from: 0,","    to: 1,","    intervals: 50",")"],"syntax":"swift"},{"text":"Improper Integrals","type":"heading","anchor":"Improper-Integrals","level":4},{"type":"paragraph","inlineContent":[{"text":"Approximate integrals to infinity:","type":"text"}]},{"type":"codeListing","code":["\/\/ ∫₀^∞ e^(-x) dx = 1","let improper = Math.improperIntegrate(","    { x in Math.exp(-x) },","    from: 0,","    upperBound: 10  \/\/ Approximate infinity",")","print(improper)  \/\/ ≈1","","\/\/ ∫₁^∞ 1\/x² dx = 1","let result = Math.improperIntegrate(","    { x in 1 \/ (x * x) },","    from: 1,","    upperBound: 100",")"],"syntax":"swift"},{"text":"Series","type":"heading","anchor":"Series","level":3},{"inlineContent":[{"text":"Calculate arithmetic and geometric series.","type":"text"}],"type":"paragraph"},{"text":"Arithmetic Series","anchor":"Arithmetic-Series","type":"heading","level":4},{"inlineContent":[{"text":"Sum of a + (a+d) + (a+2d) + … for n terms:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ 1 + 2 + 3 + 4 + 5 = 15","let sum = Math.arithmeticSeries(","    firstTerm: 1,","    difference: 1,","    terms: 5",")","print(sum)  \/\/ 15","","\/\/ Sum of even numbers: 2 + 4 + 6 + 8 + 10 = 30","let evenSum = Math.arithmeticSeries(","    firstTerm: 2,","    difference: 2,","    terms: 5",")"]},{"text":"Geometric Series","anchor":"Geometric-Series","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sum of a + ar + ar² + … for n terms:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ 1 + 2 + 4 + 8 + 16 = 31","let sum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 2,","    terms: 5",")","print(sum)  \/\/ 31","","\/\/ Sum of 1 + 0.5 + 0.25 + 0.125 = 1.875","let decaySum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 0.5,","    terms: 4",")"]},{"text":"Infinite Geometric Series","anchor":"Infinite-Geometric-Series","type":"heading","level":4},{"inlineContent":[{"text":"For |r| < 1, sum = a \/ (1 - r):","type":"text"}],"type":"paragraph"},{"code":["\/\/ 1 + 1\/2 + 1\/4 + 1\/8 + ... = 2","let infiniteSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: 0.5",")","print(infiniteSum)  \/\/ 2","","\/\/ 1 + 1\/3 + 1\/9 + 1\/27 + ... = 1.5","let thirdSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: Math(1) \/ 3",")"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"General Series","anchor":"General-Series","type":"heading"},{"inlineContent":[{"text":"Sum arbitrary series using custom term functions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Sum of squares: 1² + 2² + 3² + 4² + 5² = 55","let squareSum = Math.sum(from: 1, to: 5) { k in k * k }","print(squareSum)  \/\/ 55","","\/\/ Sum of reciprocals: 1 + 1\/2 + 1\/3 + 1\/4 + 1\/5","let harmonicSum = Math.sum(from: 1, to: 5) { k in 1 \/ k }","","\/\/ Product series (factorial): 1 × 2 × 3 × 4 × 5 = 120","let factorial = Math.product(from: 1, to: 5) { k in k }","print(factorial)  \/\/ 120"],"type":"codeListing"},{"type":"heading","anchor":"Limits","level":3,"text":"Limits"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Approximate limits as x approaches a value or infinity."}]},{"level":4,"type":"heading","text":"Limits at a Point","anchor":"Limits-at-a-Point"},{"type":"codeListing","syntax":"swift","code":["\/\/ lim(x→0) sin(x)\/x = 1","let limit = Math.limit(","    of: { x in Math.sin(x) \/ x },","    approaching: 0,","    epsilon: 0.00001",")","print(limit)  \/\/ ≈1","","\/\/ lim(x→2) (x² - 4)\/(x - 2) = 4","let algebraicLimit = Math.limit(","    of: { x in (x * x - 4) \/ (x - 2) },","    approaching: 2,","    epsilon: 0.0001",")"]},{"level":4,"type":"heading","text":"Limits at Infinity","anchor":"Limits-at-Infinity"},{"type":"codeListing","syntax":"swift","code":["\/\/ lim(x→∞) 1\/x = 0","let limit = Math.limitAtInfinity(of: { x in 1 \/ x })","print(limit)  \/\/ ≈0","","\/\/ lim(x→∞) (x² + 1)\/x² = 1","let rationalLimit = Math.limitAtInfinity(","    of: { x in (x * x + 1) \/ (x * x) },","    largeValue: 100000",")"]},{"level":3,"type":"heading","text":"Root Finding","anchor":"Root-Finding"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Find zeros of functions using numerical methods."}]},{"level":4,"type":"heading","text":"Bisection Method","anchor":"Bisection-Method"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Guaranteed convergence if f(a) and f(b) have opposite signs:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Find √2 by solving x² - 2 = 0","let root = Math.bisectionRoot(","    of: { x in x * x - 2 },","    in: 0...3,","    tolerance: 0.0001",")","print(root)  \/\/ ≈1.414","","\/\/ Find zero of sin(x) in [3, 4]","let sinRoot = Math.bisectionRoot(","    of: { x in Math.sin(x) },","    in: 3...4",")","print(sinRoot)  \/\/ ≈π"]},{"anchor":"Newtons-Method","text":"Newton’s Method","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"Faster convergence using derivative information:"}]},{"code":["\/\/ Find √2 starting from x = 1","let root = Math.newtonRoot(","    of: { x in x * x - 2 },","    initialGuess: 1,","    tolerance: 0.0001",")","print(root)  \/\/ ≈1.414","","\/\/ Find root of cubic equation","let cubicRoot = Math.newtonRoot(","    of: { x in x ** 3 - x - 1 },","    initialGuess: 1.5",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Taylor Series","anchor":"Taylor-Series"},{"inlineContent":[{"text":"Approximate functions using Taylor series expansion.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Approximate sin(x) around 0","let sinApprox = Math.taylorSeries(","    of: { x in Math.sin(x) },","    around: 0,","    at: Math.pi \/ 6,","    terms: 10",")","print(sinApprox)  \/\/ ≈0.5","","\/\/ Approximate e^x around 0","let expApprox = Math.taylorSeries(","    of: { x in Math.exp(x) },","    around: 0,","    at: 1,","    terms: 20",")","print(expApprox)  \/\/ ≈e"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Real-World Examples","anchor":"Real-World-Examples"},{"level":3,"type":"heading","text":"Physics: Velocity and Acceleration","anchor":"Physics-Velocity-and-Acceleration"},{"code":["\/\/ Position function: s(t) = t²","let position: MathFunction = { t in t * t }","","\/\/ Velocity: v(t) = ds\/dt = 2t","let velocity = Math.derivative(of: position, at: 3)","print(\"Velocity at t=3: \\(velocity) m\/s\")  \/\/ 6 m\/s","","\/\/ Acceleration: a(t) = dv\/dt = 2","let acceleration = Math.secondDerivative(of: position, at: 3)","print(\"Acceleration: \\(acceleration) m\/s²\")  \/\/ 2 m\/s²"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Engineering: Work and Energy","level":3,"anchor":"Engineering-Work-and-Energy"},{"code":["\/\/ Force varies with position: F(x) = kx (spring)","let k = Math(100)  \/\/ Spring constant","let force: MathFunction = { x in k * x }","","\/\/ Work = ∫ F(x) dx from x₀ to x₁","let work = Math.integrate(force, from: 0, to: 0.5)","print(\"Work done: \\(work) J\")  \/\/ 12.5 J"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Economics-Present-Value-of-Cash-Flows","text":"Economics: Present Value of Cash Flows","type":"heading"},{"code":["\/\/ Continuous cash flow: f(t) = 1000e^(-0.05t)","let rate = Math(0.05)","let cashFlow: MathFunction = { t in","    Math(1000) * Math.exp(-rate * t)","}","","\/\/ Present value = ∫₀^10 f(t) dt","let presentValue = Math.integrate(cashFlow, from: 0, to: 10)","print(\"Present value: $\\(presentValue)\")"],"syntax":"swift","type":"codeListing"},{"text":"Statistics: Normal Distribution","type":"heading","level":3,"anchor":"Statistics-Normal-Distribution"},{"type":"codeListing","code":["\/\/ Standard normal PDF: φ(x) = (1\/√(2π))e^(-x²\/2)","let normalPDF: MathFunction = { x in","    let coefficient = 1 \/ Math.sqrt(2 * .pi)","    let exponent = -(x * x) \/ 2","    return coefficient * Math.exp(exponent)","}","","\/\/ Probability P(-1 ≤ X ≤ 1) ≈ 0.68","let probability = Math.simpsonIntegrate(normalPDF, from: -1, to: 1)","print(\"P(-1 ≤ X ≤ 1) = \\(probability)\")"],"syntax":"swift"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/calculusoperations"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/math.Math\/documentation\/Math\/CalculusOperations"},"hierarchy":{"paths":[["doc:\/\/math.Math\/documentation\/Math"]]},"sections":[],"metadata":{"roleHeading":"API Collection","modules":[{"name":"Math"}],"role":"collectionGroup","title":"Calculus Operations"},"abstract":[{"text":"Perform numerical calculus operations including derivatives, integrals, series, and limits.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","references":{"doc://math.Math/documentation/Math/Math/taylorSeries(of:around:at:terms:)":{"role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"te