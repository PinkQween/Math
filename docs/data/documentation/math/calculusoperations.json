ath.secondDerivative(of: { x in x * x }, at: 5)","print(secondDerivative)  \/\/ ≈2 (constant for quadratic)","","\/\/ Nth derivative","let fourthDerivative = Math.nthDerivative(","    of: { x in x ** 5 },","    n: 4,","    at: 1",")","print(fourthDerivative)  \/\/ ≈120 (5! \/ 1! = 120)"]},{"type":"heading","level":3,"anchor":"Integration","text":"Integration"},{"type":"paragraph","inlineContent":[{"text":"Compute definite integrals using numerical methods.","type":"text"}]},{"type":"heading","level":4,"anchor":"Trapezoidal-Rule","text":"Trapezoidal Rule"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Basic integration using trapezoids:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ∫₀¹ x dx = 0.5","let integral = Math.integrate({ x in x }, from: 0, to: 1)","print(integral)  \/\/ ≈0.5","","\/\/ ∫₀^π sin(x) dx = 2","let sinIntegral = Math.integrate(","    { x in Math.sin(x) },","    from: 0,","    to: .pi,","    intervals: 1000",")","print(sinIntegral)  \/\/ ≈2","","\/\/ More intervals = higher accuracy","let precise = Math.integrate(","    { x in x * x },","    from: 0,","    to: 1,","    intervals: 10000",")"]},{"type":"heading","anchor":"Simpsons-Rule","text":"Simpson’s Rule","level":4},{"type":"paragraph","inlineContent":[{"text":"More accurate integration using quadratic approximation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ∫₀¹ x² dx = 1\/3","let integral = Math.simpsonIntegrate(","    { x in x * x },","    from: 0,","    to: 1,","    intervals: 100",")","print(integral)  \/\/ ≈0.333...","","\/\/ Simpson's rule is more accurate for smooth functions","let accurate = Math.simpsonIntegrate(","    { x in Math.exp(x) },","    from: 0,","    to: 1,","    intervals: 50",")"]},{"type":"heading","anchor":"Improper-Integrals","text":"Improper Integrals","level":4},{"type":"paragraph","inlineContent":[{"text":"Approximate integrals to infinity:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ∫₀^∞ e^(-x) dx = 1","let improper = Math.improperIntegrate(","    { x in Math.exp(-x) },","    from: 0,","    upperBound: 10  \/\/ Approximate infinity",")","print(improper)  \/\/ ≈1","","\/\/ ∫₁^∞ 1\/x² dx = 1","let result = Math.improperIntegrate(","    { x in 1 \/ (x * x) },","    from: 1,","    upperBound: 100",")"]},{"type":"heading","anchor":"Series","text":"Series","level":3},{"inlineContent":[{"type":"text","text":"Calculate arithmetic and geometric series."}],"type":"paragraph"},{"type":"heading","level":4,"anchor":"Arithmetic-Series","text":"Arithmetic Series"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sum of a + (a+d) + (a+2d) + … for n terms:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ 1 + 2 + 3 + 4 + 5 = 15","let sum = Math.arithmeticSeries(","    firstTerm: 1,","    difference: 1,","    terms: 5",")","print(sum)  \/\/ 15","","\/\/ Sum of even numbers: 2 + 4 + 6 + 8 + 10 = 30","let evenSum = Math.arithmeticSeries(","    firstTerm: 2,","    difference: 2,","    terms: 5",")"]},{"type":"heading","level":4,"anchor":"Geometric-Series","text":"Geometric Series"},{"type":"paragraph","inlineContent":[{"text":"Sum of a + ar + ar² + … for n terms:","type":"text"}]},{"code":["\/\/ 1 + 2 + 4 + 8 + 16 = 31","let sum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 2,","    terms: 5",")","print(sum)  \/\/ 31","","\/\/ Sum of 1 + 0.5 + 0.25 + 0.125 = 1.875","let decaySum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 0.5,","    terms: 4",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Infinite-Geometric-Series","text":"Infinite Geometric Series","level":4,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For |r| < 1, sum = a \/ (1 - r):"}]},{"code":["\/\/ 1 + 1\/2 + 1\/4 + 1\/8 + ... = 2","let infiniteSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: 0.5",")","print(infiniteSum)  \/\/ 2","","\/\/ 1 + 1\/3 + 1\/9 + 1\/27 + ... = 1.5","let thirdSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: Math(1) \/ 3",")"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":4,"anchor":"General-Series","text":"General Series"},{"type":"paragraph","inlineContent":[{"text":"Sum arbitrary series using custom term functions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Sum of squares: 1² + 2² + 3² + 4² + 5² = 55","let squareSum = Math.sum(from: 1, to: 5) { k in k * k }","print(squareSum)  \/\/ 55","","\/\/ Sum of reciprocals: 1 + 1\/2 + 1\/3 + 1\/4 + 1\/5","let harmonicSum = Math.sum(from: 1, to: 5) { k in 1 \/ k }","","\/\/ Product series (factorial): 1 × 2 × 3 × 4 × 5 = 120","let factorial = Math.product(from: 1, to: 5) { k in k }","print(factorial)  \/\/ 120"]},{"type":"heading","level":3,"anchor":"Limits","text":"Limits"},{"type":"paragraph","inlineContent":[{"text":"Approximate limits as x approaches a value or infinity.","type":"text"}]},{"type":"heading","level":4,"anchor":"Limits-at-a-Point","text":"Limits at a Point"},{"type":"codeListing","syntax":"swift","code":["\/\/ lim(x→0) sin(x)\/x = 1","let limit = Math.limit(","    of: { x in Math.sin(x) \/ x },","    approaching: 0,","    epsilon: 0.00001",")","print(limit)  \/\/ ≈1","","\/\/ lim(x→2) (x² - 4)\/(x - 2) = 4","let algebraicLimit = Math.limit(","    of: { x in (x * x - 4) \/ (x - 2) },","    approaching: 2,","    epsilon: 0.0001",")"]},{"type":"heading","level":4,"anchor":"Limits-at-Infinity","text":"Limits at Infinity"},{"type":"codeListing","syntax":"swift","code":["\/\/ lim(x→∞) 1\/x = 0","let limit = Math.limitAtInfinity(of: { x in 1 \/ x })","print(limit)  \/\/ ≈0","","\/\/ lim(x→∞) (x² + 1)\/x² = 1","let rationalLimit = Math.limitAtInfinity(","    of: { x in (x * x + 1) \/ (x * x) },","    largeValue: 100000",")"]},{"type":"heading","level":3,"anchor":"Root-Finding","text":"Root Finding"},{"type":"paragraph","inlineContent":[{"text":"Find zeros of functions using numerical methods.","type":"text"}]},{"type":"heading","level":4,"anchor":"Bisection-Method","text":"Bisection Method"},{"type":"paragraph","inlineContent":[{"text":"Guaranteed convergence if f(a) and f(b) have opposite signs:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Find √2 by solving x² - 2 = 0","let root = Math.bisectionRoot(","    of: { x in x * x - 2 },","    in: 0...3,","    tolerance: 0.0001",")","print(root)  \/\/ ≈1.414","","\/\/ Find zero of sin(x) in [3, 4]","let sinRoot = Math.bisectionRoot(","    of: { x in Math.sin(x) },","    in: 3...4",")","print(sinRoot)  \/\/ ≈π"]},{"type":"heading","level":4,"anchor":"Newtons-Method","text":"Newton’s Method"},{"type":"paragraph","inlineContent":[{"text":"Faster convergence using derivative information:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Find √2 starting from x = 1","let root = Math.newtonRoot(","    of: { x in x * x - 2 },","    initialGuess: 1,","    tolerance: 0.0001",")","print(root)  \/\/ ≈1.414","","\/\/ Find root of cubic equation","let cubicRoot = Math.newtonRoot(","    of: { x in x ** 3 - x - 1 },","    initialGuess: 1.5",")"]},{"type":"heading","level":3,"anchor":"Taylor-Series","text":"Taylor Series"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Approximate functions using Taylor series expansion."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Approximate sin(x) around 0","let sinApprox = Math.taylorSeries(","    of: { x in Math.sin(x) },","    around: 0,","    at: Math.pi \/ 6,","    terms: 10",")","print(sinApprox)  \/\/ ≈0.5","","\/\/ Approximate e^x around 0","let expApprox = Math.taylorSeries(","    of: { x in Math.exp(x) },","    around: 0,","    at: 1,","    terms: 20",")","print(expApprox)  \/\/ ≈e"]},{"type":"heading","level":2,"anchor":"Real-World-Examples","text":"Real-World Examples"},{"type":"heading","level":3,"anchor":"Physics-Velocity-and-Acceleration","text":"Physics: Velocity and Acceleration"},{"type":"codeListing","syntax":"swift","code":["\/\/ Position function: s(t) = t²","let position: MathFunction = { t in t * t }","","\/\/ Velocity: v(t) = ds\/dt = 2t","let velocity = Math.derivative(of: position, at: 3)","print(\"Velocity at t=3: \\(velocity) m\/s\")  \/\/ 6 m\/s","","\/\/ Acceleration: a(t) = dv\/dt = 2","let acceleration = Math.secondDerivative(of: position, at: 3)","print(\"Acceleration: \\(acceleration) m\/s²\")  \/\/ 2 m\/s²"]},{"type":"heading","level":3,"anchor":"Engineering-Work-and-Energy","text":"Engineering: Work and Energy"},{"type":"codeListing","syntax":"swift","code":["\/\/ Force varies with position: F(x) = kx (spring)","let k = Math(100)  \/\/ Spring constant","let force: MathFunction = { x in k * x }","","\/\/ Work = ∫ F(x) dx from x₀ to x₁","let work = Math.integrate(force, from: 0, to: 0.5)","print(\"Work done: \\(work) J\")  \/\/ 12.5 J"]},{"type":"heading","level":3,"anchor":"Economics-Present-Value-of-Cash-Flows","text":"Economics: Present Value of Cash Flows"},{"type":"codeListing","syntax":"swift","code":["\/\/ Continuous cash flow: f(t) = 1000e^(-0.05t)","let rate = Math(0.05)","let cashFlow: MathFunction = { t in","    Math(1000) * Math.exp(-rate * t)","}","","\/\/ Present value = ∫₀^10 f(t) dt","let presentValue = Math.integrate(cashFlow, from: 0, to: 10)","print(\"Present value: $\\(presentValue)\")"]},{"type":"heading","level":3,"anchor":"Statistics-Normal-Distribution","text":"Statistics: Normal Distribution"},{"type":"codeListing","syntax":"swift","code":["\/\/ Standard normal PDF: φ(x) = (1\/√(2π))e^(-x²\/2)","let normalPDF: MathFunction = { x in","    let coefficient = 1 \/ Math.sqrt(2 * .pi)","    let exponent = -(x * x) \/ 2","    return coefficient * Math.exp(exponent)","}","","\/\/ Probability P(-1 ≤ X ≤ 1) ≈ 0.68","let probability = Math.simpsonIntegrate(normalPDF, from: -1, to: 1)","print(\"P(-1 ≤ X ≤ 1) = \\(probability)\")"]}]}],"kind":"article","topicSections":[{"anchor":"Derivatives","title":"Derivatives","identifiers":["doc:\/\/math.Math\/documentation\/Math\/Ma