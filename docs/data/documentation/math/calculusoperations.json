{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The Math library provides comprehensive numerical calculus operations for arbitrary-precision computations. These operations are particularly useful for scientific computing, optimization, and mathematical analysis.","type":"text"}]},{"level":3,"text":"Derivatives","type":"heading","anchor":"Derivatives"},{"type":"paragraph","inlineContent":[{"text":"Calculate numerical derivatives using the central difference method.","type":"text"}]},{"level":4,"text":"First Derivative","type":"heading","anchor":"First-Derivative"},{"syntax":"swift","code":["\/\/ Derivative of f(x) = x�","let derivative = Math.derivative(of: { x in x * x }, at: 3)","print(derivative)  \/\/ H6 (exact: 2x = 2�3 = 6)","","\/\/ Derivative of f(x) = sin(x)","let sinDerivative = Math.derivative(of: { x in Math.sin(x) }, at: 0)","print(sinDerivative)  \/\/ H1 (exact: cos(0) = 1)","","\/\/ Custom step size for higher precision","let preciseDerivative = Math.derivative(","    of: { x in x * x * x },","    at: 2,","    h: 0.00001",")"],"type":"codeListing"},{"anchor":"Higher-Order-Derivatives","type":"heading","text":"Higher-Order Derivatives","level":4},{"type":"codeListing","code":["\/\/ Second derivative of f(x) = x�","let secondDerivative = Math.secondDerivative(of: { x in x * x }, at: 5)","print(secondDerivative)  \/\/ H2 (constant for quadratic)","","\/\/ Nth derivative","let fourthDerivative = Math.nthDerivative(","    of: { x in x ** 5 },","    n: 4,","    at: 1",")","print(fourthDerivative)  \/\/ H120 (5! \/ 1! = 120)"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Integration","text":"Integration"},{"inlineContent":[{"type":"text","text":"Compute definite integrals using numerical methods."}],"type":"paragraph"},{"type":"heading","level":4,"anchor":"Trapezoidal-Rule","text":"Trapezoidal Rule"},{"inlineContent":[{"type":"text","text":"Basic integration using trapezoids:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ +�� x dx = 0.5","let integral = Math.integrate({ x in x }, from: 0, to: 1)","print(integral)  \/\/ H0.5","","\/\/ +�^� sin(x) dx = 2","let sinIntegral = Math.integrate(","    { x in Math.sin(x) },","    from: 0,","    to: .�,","    intervals: 1000",")","print(sinIntegral)  \/\/ H2","","\/\/ More intervals = higher accuracy","let precise = Math.integrate(","    { x in x * x },","    from: 0,","    to: 1,","    intervals: 10000",")"],"type":"codeListing"},{"type":"heading","level":4,"anchor":"Simpsons-Rule","text":"Simpson’s Rule"},{"inlineContent":[{"text":"More accurate integration using quadratic approximation:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ +�� x� dx = 1\/3","let integral = Math.simpsonIntegrate(","    { x in x * x },","    from: 0,","    to: 1,","    intervals: 100",")","print(integral)  \/\/ H0.333...","","\/\/ Simpson's rule is more accurate for smooth functions","let accurate = Math.simpsonIntegrate(","    { x in Math.exp(x) },","    from: 0,","    to: 1,","    intervals: 50",")"],"type":"codeListing"},{"type":"heading","level":4,"anchor":"Improper-Integrals","text":"Improper Integrals"},{"inlineContent":[{"text":"Approximate integrals to infinity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ +�^\u001e e^(-x) dx = 1","let improper = Math.improperIntegrate(","    { x in Math.exp(-x) },","    from: 0,","    upperBound: 10  \/\/ Approximate \u001e",")","print(improper)  \/\/ H1","","\/\/ +�^\u001e 1\/x� dx = 1","let result = Math.improperIntegrate(","    { x in 1 \/ (x * x) },","    from: 1,","    upperBound: 100",")"]},{"type":"heading","level":3,"anchor":"Series","text":"Series"},{"inlineContent":[{"text":"Calculate arithmetic and geometric series.","type":"text"}],"type":"paragraph"},{"level":4,"text":"Arithmetic Series","type":"heading","anchor":"Arithmetic-Series"},{"inlineContent":[{"text":"Sum of a + (a+d) + (a+2d) + … for n terms:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ 1 + 2 + 3 + 4 + 5 = 15","let sum = Math.arithmeticSeries(","    firstTerm: 1,","    difference: 1,","    terms: 5",")","print(sum)  \/\/ 15","","\/\/ Sum of even numbers: 2 + 4 + 6 + 8 + 10 = 30","let evenSum = Math.arithmeticSeries(","    firstTerm: 2,","    difference: 2,","    terms: 5",")"],"type":"codeListing"},{"anchor":"Geometric-Series","type":"heading","text":"Geometric Series","level":4},{"inlineContent":[{"text":"Sum of a + ar + ar� + … for n terms:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ 1 + 2 + 4 + 8 + 16 = 31","let sum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 2,","    terms: 5",")","print(sum)  \/\/ 31","","\/\/ Sum of 1 + 0.5 + 0.25 + 0.125 = 1.875","let decaySum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 0.5,","    terms: 4",")"],"type":"codeListing"},{"level":4,"text":"Infinite Geometric Series","type":"heading","anchor":"Infinite-Geometric-Series"},{"type":"paragraph","inlineContent":[{"text":"For |r| < 1, sum = a \/ (1 - r):","type":"text"}]},{"syntax":"swift","code":["\/\/ 1 + 1\/2 + 1\/4 + 1\/8 + ... = 2","let infiniteSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: 0.5",")","print(infiniteSum)  \/\/ 2","","\/\/ 1 + 1\/3 + 1\/9 + 1\/27 + ... = 1.5","let thirdSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: Math(1) \/ 3",")"],"type":"codeListing"},{"anchor":"General-Series","type":"heading","text":"General Series","level":4},{"inlineContent":[{"text":"Sum arbitrary series using custom term functions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Sum of squares: 1� + 2� + 3� + 4� + 5� = 55","let squareSum = Math.sum(from: 1, to: 5) { k in k * k }","print(squareSum)  \/\/ 55","","\/\/ Sum of reciprocals: 1 + 1\/2 + 1\/3 + 1\/4 + 1\/5","let harmonicSum = Math.sum(from: 1, to: 5) { k in 1 \/ k }","","\/\/ Product series (factorial): 1 � 2 � 3 � 4 � 5 = 120","let factorial = Math.product(from: 1, to: 5) { k in k }","print(factorial)  \/\/ 120"],"syntax":"swift"},{"anchor":"Limits","type":"heading","text":"Limits","level":3},{"inlineContent":[{"text":"Approximate limits as x approaches a value or infinity.","type":"text"}],"type":"paragraph"},{"anchor":"Limits-at-a-Point","type":"heading","text":"Limits at a Point","level":4},{"syntax":"swift","code":["\/\/ lim(x�0) sin(x)\/x = 1","let limit = Math.limit(","    of: { x in Math.sin(x) \/ x },","    approaching: 0,","    epsilon: 0.00001",")","print(limit)  \/\/ H1","","\/\/ lim(x�2) (x� - 4)\/(x - 2) = 4","let algebraicLimit = Math.limit(","    of: { x in (x * x - 4) \/ (x - 2) },","    approaching: 2,","    epsilon: 0.0001",")"],"type":"codeListing"},{"anchor":"Limits-at-Infinity","text":"Limits at Infinity","type":"heading","level":4},{"syntax":"swift","code":["\/\/ lim(x�\u001e) 1\/x = 0","let limit = Math.limitAtInfinity(of: { x in 1 \/ x })","print(limit)  \/\/ H0","","\/\/ lim(x�\u001e) (x� + 1)\/x� = 1","let rationalLimit = Math.limitAtInfinity(","    of: { x in (x * x + 1) \/ (x * x) },","    largeValue: 100000",")"],"type":"codeListing"},{"anchor":"Root-Finding","text":"Root Finding","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Find zeros of functions using numerical methods."}],"type":"paragraph"},{"anchor":"Bisection-Method","text":"Bisection Method","type":"heading","level":4},{"inlineContent":[{"text":"Guaranteed convergence if f(a) and f(b) have opposite signs:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Find \u001a2 by solving x� - 2 = 0","let root = Math.bisectionRoot(","    of: { x in x * x - 2 },","    in: 0...3,","    tolerance: 0.0001",")","print(root)  \/\/ H1.414","","\/\/ Find zero of sin(x) in [3, 4]","let sinRoot = Math.bisectionRoot(","    of: { x in Math.sin(x) },","    in: 3...4",")","print(sinRoot)  \/\/ H�"]},{"type":"heading","level":4,"anchor":"Newtons-Method","text":"Newton’s Method"},{"inlineContent":[{"text":"Faster convergence using derivative information:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Find \u001a2 starting from x = 1","let root = Math.newtonRoot(","    of: { x in x * x - 2 },","    initialGuess: 1,","    tolerance: 0.0001",")","print(root)  \/\/ H1.414","","\/\/ Find root of cubic equation","let cubicRoot = Math.newtonRoot(","    of: { x in x ** 3 - x - 1 },","    initialGuess: 1.5",")"]},{"level":3,"text":"Taylor Series","type":"heading","anchor":"Taylor-Series"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Approximate functions using Taylor series expansion."}]},{"syntax":"swift","code":["\/\/ Approximate sin(x) around 0","let sinApprox = Math.taylorSeries(","    of: { x in Math.sin(x) },","    around: 0,","    at: Math.� \/ 6,","    terms: 10",")","print(sinApprox)  \/\/ H0.5","","\/\/ Approximate e^x around 0","let expApprox = Math.taylorSeries(","    of: { x in Math.exp(x) },","    around: 0,","    at: 1,","    terms: 20",")","print(expApprox)  \/\/ He"],"type":"codeListing"},{"level":2,"text":"Real-World Examples","type":"heading","anchor":"Real-World-Examples"},{"level":3,"type":"heading","text":"Physics: Velocity and Acceleration","anchor":"Physics-Velocity-and-Acceleration"},{"syntax":"swift","code":["\/\/ Position function: s(t) = t�","let position: MathFunction = { t in t * t }","","\/\/ Velocity: v(t) = ds\/dt = 2t","let velocity = Math.derivative(of: position, at: 3)","print(\"Velocity at t=3: \\(velocity) m\/s\")  \/\/ 6 m\/s","","\/\/ Acceleration: a(t) = dv\/dt = 2","let acceleration = Math.secondDerivative(of: position, at: 3)","print(\"Acceleration: \\(acceleration) m\/s�\")  \/\/ 2 m\/s�"],"type":"codeListing"},{"level":3,"text":"Engineering: Work and Energy","type":"heading","anchor":"Engineering-Work-and-Energy"},{"syntax":"swift","code":["\/\/ Force varies with position: F(x) = kx (spring)","let k = Math(100)  \/\/ Spring constant","let force: MathFunction = { x in k * x }","","\/\/ Work = + F(x) dx from x� to x�","let work = Math.integrate(force, from: 0, to: 0.5)","print(\"Work done: \\(work) J\")  \/\/ 12.5 J"],"type":"codeListing"},{"anchor":"Economics-Present-Value-of-Cash-Flows","type":"heading","text":"Economics: Present Value of Cash Flows","level":3},{"type":"codeListing","code":["\/\/ Continuous cash flow: f(t) = 1000e^(-0.05t)","let rate = Math(0.05)","let cashFlow: MathFunction = { t in","    Math(1000) * Math.exp(-rate * t)","}","","\/\/ Present value = +��p f(t) dt","let presentValue = Math.integrate(cashFlow, from: 0, to: 10)","print(\"Present value: $\\(presentValue)\")"],"syntax":"swift"},{"anchor":"Statistics-Normal-Distribution","type":"heading","text":"Statistics: Normal Distribution","level":3},{"type":"codeListing","code":["\/\/ Standard normal PDF: �(x) = (1\/\u001a2�)e^(-x�\/2)","let normalPDF: MathFunction = { x in","    let coefficient = 1 \/ Math.sqrt(2 * .�)","    let exponent = -(x * x) \/ 2","    return coefficient * Math.exp(exponent)","}","","\/\/ Probability P(-1 d X d 1) H 0.68","let probability = Math.simpsonIntegrate(normalPDF, from: -1, to: 1)","print(\"P(-1 d X d 1) = \\(probability)\")"],"syntax":"swift"}]}],"abstract":[{"text":"Perform numerical calculus operations including derivatives, integrals, series, and limits.","type":"text"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"Math"}],"title":"Calculus Operations"},"identifier":{"url":"doc:\/\/math.Math\/documentation\/Math\/CalculusOperations","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/math.Math\/documentation\/Math"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/math\/calculusoperations"]}],"seeAlsoSections":[{"title":"New Features","generated":true,"identifiers":["doc:\/\/math.Math\/documentation\/Math\/ComplexNumbers","doc:\/\/ma