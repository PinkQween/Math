th.exp(-x) },","    from: 0,","    upperBound: 10  \/\/ Approximate \u001e",")","print(improper)  \/\/ H1","","\/\/ +�^\u001e 1\/x� dx = 1","let result = Math.improperIntegrate(","    { x in 1 \/ (x * x) },","    from: 1,","    upperBound: 100",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Series","level":3,"type":"heading","text":"Series"},{"inlineContent":[{"type":"text","text":"Calculate arithmetic and geometric series."}],"type":"paragraph"},{"type":"heading","level":4,"text":"Arithmetic Series","anchor":"Arithmetic-Series"},{"inlineContent":[{"type":"text","text":"Sum of a + (a+d) + (a+2d) + … for n terms:"}],"type":"paragraph"},{"code":["\/\/ 1 + 2 + 3 + 4 + 5 = 15","let sum = Math.arithmeticSeries(","    firstTerm: 1,","    difference: 1,","    terms: 5",")","print(sum)  \/\/ 15","","\/\/ Sum of even numbers: 2 + 4 + 6 + 8 + 10 = 30","let evenSum = Math.arithmeticSeries(","    firstTerm: 2,","    difference: 2,","    terms: 5",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Geometric-Series","level":4,"type":"heading","text":"Geometric Series"},{"inlineContent":[{"type":"text","text":"Sum of a + ar + ar� + … for n terms:"}],"type":"paragraph"},{"code":["\/\/ 1 + 2 + 4 + 8 + 16 = 31","let sum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 2,","    terms: 5",")","print(sum)  \/\/ 31","","\/\/ Sum of 1 + 0.5 + 0.25 + 0.125 = 1.875","let decaySum = Math.geometricSeries(","    firstTerm: 1,","    ratio: 0.5,","    terms: 4",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Infinite-Geometric-Series","level":4,"type":"heading","text":"Infinite Geometric Series"},{"inlineContent":[{"type":"text","text":"For |r| < 1, sum = a \/ (1 - r):"}],"type":"paragraph"},{"code":["\/\/ 1 + 1\/2 + 1\/4 + 1\/8 + ... = 2","let infiniteSum = Math.infiniteGeometricSeries(","    firstTerm: 1,","    ratio: 0.5",")","print(infiniteSum)  \/\/ 2","","\/\/ 1 + 1\/3 + 1\/9 + 1\/27 + ... = 1.5","let thirdSum = Math.infiniteGeometricSeries(","    firstTerm: 1,",