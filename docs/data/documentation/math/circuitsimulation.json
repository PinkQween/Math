,"navigatorTitle":[{"text":"Wire","kind":"identifier"}],"abstract":[{"text":"A wire carries a signal between circuit components.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Wire","kind":"identifier"}]},"doc://math.Math/documentation/Math/NOTGate":{"url":"\/documentation\/math\/notgate","role":"symbol","kind":"symbol","identifier":"doc:\/\/math.Math\/documentation\/Math\/NOTGate","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NOTGate","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"NOTGate","kind":"identifier"}],"title":"NOTGate","abstract":[{"text":"A NOT gate (inverter).","type":"text"}]},"doc://math.Math/documentation/Math/ANDGate":{"url":"\/documentation\/math\/andgate","role":"symbol","title":"ANDGate","kind":"symbol","type":"topic","identifier":"doc:\/\/math.Math\/documentation\/Math\/ANDGate","navigatorTitle":[{"text":"ANDGate","kind":"identifier"}],"abstract":[{"type":"text","text":"An AND gate."}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"ANDGate","kind":"identifier"}]},"doc://math.Math/documentation/Math/Multiplexer2to1":{"navigatorTitle":[{"kind":"identifier","text":"Multiplexer2to1"}],"type":"topic","url":"\/documentation\/math\/multiplexer2to1","kind":"symbol","identifier":"doc:\/\/math.Math\/documentation\/Math\/Multiplexer2to1","role":"symbol","title":"Multiplexer2to1","abstract":[{"type":"text","text":"A multiplexer (2-to-1)."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Multiplexer2to1"}]},"doc://math.Math/documentation/Math/Signal":{"navigatorTitle":[{"text":"Signal","kind":"identifier"}],"identifier":"doc:\/\/math.Math\/documentation\/Math\/Signal","kind":"symbol","url":"\/documentation\/math\/signal","type":"topic","role":"symbol","title":"Signal","abstract":[{"type":"text","text":"Represents a digital signal state in a circuit."}],"fragments