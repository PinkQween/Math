t":"Rectangular Form (a + bi)","anchor":"Rectangular-Form-a-+-bi"},{"code":["\/\/ Create from real and imaginary parts","let z1 = Complex(real: 3, imaginary: 4)  \/\/ 3 + 4i","let z2 = Complex(real: 1, imaginary: -2) \/\/ 1 - 2i","","\/\/ Create purely real number","let realNum = Complex(real: 5)  \/\/ 5 + 0i","let alsoReal = Complex(Math(5)) \/\/ Convenience initializer","","\/\/ Create purely imaginary number","let imagNum = Complex(real: 0, imaginary: 3)  \/\/ 0 + 3i"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":4,"anchor":"Polar-Form-r-%EF%BF%BD","text":"Polar Form (r �)"},{"type":"codeListing","syntax":"swift","code":["\/\/ Create from magnitude and phase","let polar = Complex(magnitude: 5, phase: Math.� \/ 4)","","\/\/ The phase angle respects MathSettings.angleMode","Calculate(settings: .init(angleMode: .degrees)) {","    let z = Complex(magnitude: 1, phase: 90)  \/\/ 0 + 1i","}"]},{"text":"Basic Arithmetic","level":3,"anchor":"Basic-Arithmetic","type":"heading"},{"inlineContent":[{"type":"text","text":"Complex numbers support all standard arithmetic operations:"}],"type":"paragraph"},{"syntax":"swift","code":["let z1 = Complex(real: 3, imaginary: 4)","let z2 = Complex(real: 1, imaginary: -2)","","let sum = z1 + z2        \/\/ 4 + 2i","let difference = z1 - z2  \/\/ 2 + 6i","let product = z1 * z2     \/\/ 11 - 2i","let quotient = z1 \/ z2    \/\/ -1 + 2i","let negation = -z1        \/\/ -3 - 4i","","\/\/ Scalar operations","let scaled = z1 * Math(2)     \/\/ 6 + 8i","let divided = z1 \/ Math(2)    \/\/ 1.5 + 2i"],"type":"codeListing"},{"type":"heading","level":3,"text":"Properties and Functions","anchor":"Properties-and-Functions"},{"text":"Magnitude and Phase","level":4,"anchor":"Magnitude-and-Phase","type":"heading"},{"code":["let z = Complex(real: 3, imaginary: 4)","","print(z.magnitude)  \/\/ 5 (|z| = \u001a(3� + 4�))","print(z.abs)        \/\/ 5 (alias for magnitude)","","print(z.phase)      \/\/ H0.927 radians or H53.13�","print(z.argument)   \/\/ Same as phase"],"type":"codeListing","syntax":"swift"},{"text":"Conjugate","level":4,"anchor":"Conjugate","type":"heading"},{"inlineContent":[{"text":"The conjugate of a complex number flips the sign of the imaginary part:","type":"text"}],"type":"paragraph"},{"code":["let z = Complex(real: 3, imaginary: 4)","let conjugate = z.conjugate  \/\/ 3 - 4i","","\/\/ Property: z � z* = |z|�","let product = z * z.conjugate","print(product.real)  \/\/ 25 (= 5�)","print(product.imaginary)  \/\/ 0"],"type":"codeListing","syntax":"swift"},{"anchor":"Type-Checks","text":"Type Checks","type":"heading","level":4},{"syntax":"swift","code":["let realNum = Complex(real: 5)","print(realNum.isReal)  \/\/ true","","let imagNum = Complex(imaginary: 3)","print(imagNum.isImaginary)  \/\/ true","","let zero = Complex.zero","print(zero.isZero)  \/\/ true"],"type":"codeListing"},{"text":"Advanced Functions","anchor":"Advanced-Functions","level":3,"type":"heading"},{"text":"Powers and Roots","anchor":"Powers-and-Roots","level":4,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["let z = Complex(real: 1, imaginary: 1)","","\/\/ Integer power (fast exponentiation)","let squared = z.power(2)  \/\/ 0 + 2i","let cubed = z.power(3)    \/\/ -2 + 2i","","\/\/ Square root","let sqrtResult = Complex.sqrt(z)","","\/\/ General power (uses exp and ln)","let w = Complex(real: 2, imaginary: 0)","let power = Complex.pow(z, w)  \/\/ z�"]},{"level":4,"text":"Exponential and Logarithm","anchor":"Exponential-and-Logarithm","type":"heading"},{"syntax":"swift","type":"codeListing","code":["let z = Complex(real: 1, imaginary: Math.�)","","\/\/ Euler's formula: e^(i�) = -1","let exp = Complex.exp(z)  \/\/ H-e + 0i","","\/\/ Natural logarithm","let w = Complex(real: Math.e, imaginary: 0)","let ln = Complex.ln(w)  \/\/ H1 + 0i"]},{"type":"heading","text":"Trigonometric Functions","anchor":"Trigonometric-Functions","level":4},{"code":["let z = Complex(real: 0, imaginary: 1)","","let sinZ = Complex.sin(z)   \/\/ Imaginary sine","let cosZ = Complex.cos(z)   \/\/ Complex cosine","let tanZ = Complex.tan(z)   \/\/ Complex tangent"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Hyperbolic Functions","anchor":"Hyperbolic-Functions","type":"heading"},{"syntax":"swift","code":["let z = Complex(real: 1, imaginary: 0)","","let sinhZ = Complex.sinh(z)","let coshZ = Complex.cosh(z)","let tanhZ = Complex.tanh(z)"],"type":"codeListing"},{"type":"heading","text":"Common Constants","anchor":"Common-Constants","level":3},{"syntax":"swift","type":"codeListing","code":["Complex.zero  \/\/ 0 + 0i","Complex.one   \/\/ 1 + 0i","Complex.i     \/\/ 0 + 1i (imaginary unit)"]},{"type":"heading","text":"Examples","anchor":"Examples","level":2},{"type":"heading","text":"Solving Quadratic Equations","anchor":"Solving-Quadratic-Equations","level":3},{"inlineContent":[{"text":"Solve ax� + bx + c = 0 for complex roots:","type":"text"}],"type":"paragraph"},{"code":["func solveQuadratic(a: Math, b: Math, c: Math) -> (Complex, Complex) {","    let discriminant = b * b - 4 * a * c","","    if discriminant >= 0 {","        \/\/ Real roots","        let sqrt = Math.sqrt(discriminant)","        let root1 = Complex((-b + sqrt) \/ (2 * a))","        let root2 = Complex((-b - sqrt) \/ (2 * a))","        return (root1, root2)","    } else {","        \/\/ Complex roots","        let realPart = -b \/ (2 * a)","        let imagPart = Math.sqrt(-discriminant) \/ (2 * a)","        let root1 = Complex(real: realPart, imaginary: imagPart)","        let root2 = Complex(real: realPart, imaginary: -imagPart)","        return (root1, root2)","    }","}","","\/\/ Example: x� + 1 = 0","let (r1, r2) = solveQuadratic(a: 1, b: 0, c: 1)","print(r1)  \/\/ 0 + 1i","print(r2)  \/\/ 0 - 1i"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"Electrical Engineering: Impedance","anchor":"Electrical-Engineering-Impedance"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calculate total impedance in AC circuits:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Resistor: Z = R","let resistor = Complex(real: 100)  \/\/ 100�","","\/\/ Capacitor: Z = -i\/(�C)","let frequency = Math(60)  \/\/ 60 Hz","let capacitance = Math(0.0001)  \/\/ 100�F","let omega = 2 * .� * frequency","let capacitor = Complex(real: 0, imaginary: -1 \/ (omega * capacitance))","","\/\/ Inductor: Z = i�L","let inductance = Math(0.1)  \/\/ 100mH","let inductor = Complex(real: 0, imaginary: omega * inductance)","","\/\/ Series circuit","let totalImpedance = resistor + capacitor + inductor","print(\"Total impedance: \\(totalImpedance)\")","print(\"Magnitude: \\(totalImpedance.magnitude) �\")","print(\"Phase: \\(totalImpedance.phase) radians\")"]},{"anchor":"Mandelbrot-Set","level":3,"type":"heading","text":"Mandelbrot Set"},{"type":"paragraph","inlineContent":[{"text":"Check if a point is in the Mandelbrot set:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func inMandelbrotSet(_ c: Complex, maxIterations: Int = 100) -> Bool {","    var z = Complex.zero","","    for _ in 0..<maxIterations {","        z = z.power(2) + c","","        if z.magnitude > 2 {","            return false","        }","    }","","    return true","}","","let point = Complex(real: 0, imaginary: 1)","if inMandelbrotSet(point) {","    print(\"Point is in the Mandelbrot set\")","}"]}]}],"references":{"doc://math.Math/documentation/Math/Complex/real":{"kind":"symbol","url":"\/documentation\/math\/complex\/real","role":"symbol","identifier":"doc:\/\/math.Math\/documentation\/Math\/Complex\/real","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"real","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Math","kind":"typeIdentifier","preciseIdentifier":"s:4MathAAV"}],"type":"topic","title":"real","abstract":[{"text":"Real part (a in a + bi)","type":"text"}]},"doc://math.Math/documentation/Math/Complex/tanh(_:)":{"title":"tanh(_:)","kind":"