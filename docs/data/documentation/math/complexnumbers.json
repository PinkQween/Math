rcuits:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Resistor: Z = R","let resistor = Complex(real: 100)  \/\/ 100�","","\/\/ Capacitor: Z = -i\/(�C)","let frequency = Math(60)  \/\/ 60 Hz","let capacitance = Math(0.0001)  \/\/ 100�F","let omega = 2 * .� * frequency","let capacitor = Complex(real: 0, imaginary: -1 \/ (omega * capacitance))","","\/\/ Inductor: Z = i�L","let inductance = Math(0.1)  \/\/ 100mH","let inductor = Complex(real: 0, imaginary: omega * inductance)","","\/\/ Series circuit","let totalImpedance = resistor + capacitor + inductor","print(\"Total impedance: \\(totalImpedance)\")","print(\"Magnitude: \\(totalImpedance.magnitude) �\")","print(\"Phase: \\(totalImpedance.phase) radians\")"]},{"level":3,"text":"Mandelbrot Set","anchor":"Mandelbrot-Set","type":"heading"},{"inlineContent":[{"type":"text","text":"Check if a point is in the Mandelbrot set:"}],"type":"paragraph"},{"syntax":"swift","code":["func inMandelbrotSet(_ c: Complex, maxIterations: Int = 100) -> Bool {","    var z = Complex.zero","","    for _ in 0..<maxIterations {","        z = z.power(2) + c","","        if z.magnitude > 2 {","            return false","        }","    }","","    return true","}","","let point = Complex(real: 0, imaginary: 1)","if inMandelbrotSet(point) {","    print(\"Point is in the Mandelbrot set\")","}"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://math.Math/documentation/Math/Complex/isZero":{"identifier":"doc:\/\/math.Math\/documentation\/Math\/Complex\/isZero","title":"isZero","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"isZero","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"text":"Returns true if both parts are zero","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","url":"\/documentation\/math\/complex\/iszero"},"doc://math.Math/documentation/Math/Complex/exp(_:)":{"type":"topic","